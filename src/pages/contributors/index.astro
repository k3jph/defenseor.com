---
import Layout from '../../layouts/Layout.astro';
import { contributors, currentContributors, editors, personSlug } from '../../data/catalogue.mjs';
---
<Layout title="The contributors" active="Contributors" description="Meet the handbook’s editors and browse the authors whose contributions appear in its first and second editions.">
  <div class="wrap page-intro"><p class="eyebrow">The people behind the chapters</p><h1>An authored collection.</h1><p class="lead">The handbook brings individual contributions into a shared reference. This index keeps each author’s work visible across both editions, with chapter authorship and edition details kept together.</p></div>
  <section class="wrap editor-section" aria-labelledby="editors-title"><h2 id="editors-title" class="eyebrow">The editors</h2><div class="editor-grid">{editors.map((e, i) => <article class="editor-profile"><img class={i === 0 ? 'portrait' : 'badge'} src={e.image} alt="" width="90" height="90" /><div><h3><a href={`/contributors/${personSlug(e.name)}/`}>{e.name}</a></h3><p>Co-editor · First and second editions</p><a class="text-link" href={e.url}>Personal website <span aria-hidden="true">↗</span></a></div></article>)}</div></section>
  <section class="wrap contributor-section" data-filter data-noun="contributors" aria-label="Contributor index"><form data-enhanced hidden class="filter-bar" role="search"><div class="search-field"><label for="person-search">Find a contributor</label><input id="person-search" name="q" type="search" placeholder="Search names or chapter titles" /></div><button class="button" type="submit">Search</button><button class="text-button" type="button" data-clear>Clear</button></form><p class="result-count" data-count role="status" aria-live="polite">{contributors.length} contributors</p><p class="empty-state" data-empty hidden>No contributors match. Try a surname or clear the search.</p><div class="contributor-grid">{contributors.map(p => <article data-search={`${p.name} ${p.chapters.map(c => c.title).join(' ')}`}><p class="eyebrow">{p.editor ? 'Editor & contributor' : p.chapters.some(c => c.edition === '2e') ? 'Chapter author' : 'First-edition author'}</p><h2><a href={`/contributors/${p.slug}/`}>{p.name}</a></h2><p>{p.chapters.length} chapter {p.chapters.length === 1 ? 'record' : 'records'} · {p.chapters.some(c => c.edition === '2e') && p.chapters.some(c => c.edition === '1e') ? 'Both editions' : p.chapters[0].edition === '2e' ? 'Second edition' : 'First edition'}</p></article>)}</div><p class="source-note">The second edition credits {currentContributors.length} distinct chapter authors. This combined index includes {contributors.length} contributors across both editions. Contributor pages record handbook authorship, not a comprehensive professional biography.</p></section>
</Layout>
