---
import Layout from '../../layouts/Layout.astro';
import ChapterList from '../../components/ChapterList.astro';
import { chapters, editions, sources, bookCitation } from '../../data/catalogue.mjs';
const edition = editions['1e'];
const records = chapters.filter(c => c.edition === '1e');
---
<Layout title="First-edition archive" active="The book" image={edition.cover} imageAlt="First-edition handbook cover" description="The original 2020 handbook, with its four-part contents, contributors, publication reference, and links to first-edition chapters.">
  <div class="wrap page-intro"><p class="eyebrow">The earlier collection · 2020</p><h1>First-edition archive.</h1><p class="lead">Twenty chapters in four parts. These are the first-edition records, with their original numbering and bylines, not an alternate contents list for the second edition.</p><a class="text-link" href="/book/">Return to the second edition <span aria-hidden="true">→</span></a></div>
  <div class="wrap archive-intro"><img src={edition.cover} alt="First-edition cover" width="160" height="240" /><div><p class="eyebrow">Edited by Natalie M. Scala and James P. Howard, II</p><h2>Handbook of Military and Defense Operations Research</h2><p>Chapman &amp; Hall/CRC · 2020 · Print ISBN {edition.isbn}</p><p id="first-citation">{bookCitation('1e')}</p><a href="/citations/first-edition.bib" download>BibTeX reference</a> · <a href="/citations/first-edition.ris" download>RIS reference</a><p><a class="text-link" href="/chapters/1e/">Search the first-edition chapters</a> · <a href="https://doi.org/10.1201/9780429467219">View the published volume</a></p></div></div>
  <div class="wrap catalogue">{edition.parts.map((part, i) => <section class="part-section"><h2><span class="eyebrow">Part {['I', 'II', 'III', 'IV'][i]}</span>{part}</h2><ChapterList chapters={records.filter(c => c.part === i)} /></section>)}<p class="source-note">The original part structure follows <a href={sources.first}>Natalie Scala’s first-edition table of contents</a>. Chapter titles and references use the published chapter records. <a href="/about/#editorial">About the edition-specific catalogue.</a></p></div>
</Layout>
