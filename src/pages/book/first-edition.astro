---
import Layout from '../../layouts/Layout.astro';
import ChapterList from '../../components/ChapterList.astro';
import { chapters, editions, sources, bookCitation } from '../../data/catalogue.mjs';
const edition = editions['1e'];
const records = chapters.filter(c => c.edition === '1e');
---
<Layout title="First-edition archive" active="The book">
  <div class="wrap page-intro"><p class="eyebrow">The earlier collection · 2020</p><h1>First-edition archive.</h1><p class="lead">Twenty chapters in four parts. These are the first-edition records, with their original numbering and bylines, not an alternate contents list for the second edition.</p><a class="text-link" href="/book/">Return to the second edition <span aria-hidden="true">→</span></a></div>
  <div class="wrap archive-intro"><img src={edition.cover} alt="First-edition cover" width="160" height="240" /><div><p class="eyebrow">Edited by Natalie M. Scala and James P. Howard, II</p><h2>Handbook of Military and Defense Operations Research</h2><p>Chapman &amp; Hall/CRC · 2020 · Print ISBN {edition.isbn}</p><p id="first-citation">{bookCitation('1e')}</p><a href="/citations/first-edition.bib" download>BibTeX reference</a></div></div>
  <div class="wrap catalogue">{edition.parts.map((part, i) => <section class="part-section"><h2><span class="eyebrow">Part {['I', 'II', 'III', 'IV'][i]}</span>{part}</h2><ChapterList chapters={records.filter(c => c.part === i)} /></section>)}<p class="source-note">The archived contents follow <a href={sources.first}>Natalie Scala’s first-edition table of contents</a>. Numbering and author order are preserved independently from the second edition. Bibliographic year and print ISBN are also recorded on <a href={sources.james}>James Howard’s book site</a>.</p></div>
</Layout>
