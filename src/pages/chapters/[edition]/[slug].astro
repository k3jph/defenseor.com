---
import Layout from '../../../layouts/Layout.astro';
import ChapterList from '../../../components/ChapterList.astro';
import { chapters, editions, personSlug, title, publisher, chapterPathways, catalogueUrl } from '../../../data/catalogue.mjs';
import { chapterNotes } from '../../../data/chapter-notes.mjs';
import { chapterCitation } from '../../../data/citations.mjs';
export function getStaticPaths() { return chapters.map(chapter => ({ params: { edition: chapter.edition, slug: chapter.slug }, props: { chapter } })); }
const { chapter: c } = Astro.props;
const edition = editions[c.edition];
const note = chapterNotes[c.id];
const paths = chapterPathways(c);
const siblings = chapters.filter(item => item.edition === c.edition);
const related = siblings.filter(item => item.id !== c.id && item.topics.some(topic => c.topics.includes(topic))).slice(0, 3);
const previous = siblings.find(item => item.number === c.number - 1);
const next = siblings.find(item => item.number === c.number + 1);
const [pageStart, pageEnd] = c.pages.split('-');
const schema = { '@context': 'https://schema.org', '@type': 'Chapter', name: c.title, position: c.number, identifier: c.doi, url: `https://defenseor.com${c.url}`, pageStart, pageEnd, author: c.authors.map(name => ({ '@type': 'Person', name })), isPartOf: { '@type': 'Book', name: title, bookEdition: c.edition === '2e' ? '2' : '1', isbn: edition.isbn, copyrightYear: edition.year } };
---
<Layout title={c.title} active="Chapters" schema={schema} image={edition.cover} imageAlt={`${edition.label} handbook cover`} description={note ? note.overview.split('. ').slice(0, 2).join('. ') + '.' : `${c.title}, by ${c.authors.join(', ')}. First-edition chapter ${c.number}, pages ${c.pages}, with a published reference and DOI.`}>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={catalogueUrl(c.edition)}>{edition.label}</a><span aria-hidden="true">/</span><span>Chapter {c.number}</span></nav>
    {c.edition === '1e' && <aside class="archive-notice">First-edition archive · 2020. <a href="/chapters/">Explore the second edition.</a></aside>}
    <header class="chapter-header"><div class="chapter-ordinal" aria-hidden="true">{String(c.number).padStart(2, '0')}</div><div><p class="eyebrow">{edition.label} · Part {['I', 'II', 'III', 'IV'][c.part]} · {edition.parts[c.part]}</p><h1>{c.title}</h1><p class="chapter-authors">{c.authors.map((name, i) => <>{i > 0 && <span class="author-separator">; </span>}<a href={`/contributors/${personSlug(name)}/`}>{name}</a></>)}</p></div></header>
    <div class="article-grid">
      <article class="prose">
        <h2>{note ? 'About this chapter' : 'In the first edition'}</h2>
        {note ? <><p>{note.overview}</p><p class="small editorial-credit">Companion overview · <a href="/about/#editorial">About our editorial material</a></p></> : <p>This contribution appears in the first edition of <cite>{title}</cite>, in “{edition.parts[c.part]},” on pages {c.pages.replace('-', '–')}. Its published reference and chapter access link are provided below. The subject links on this page stay within the first-edition collection.</p>}
        <p><a class="button" href={`https://doi.org/${c.doi}`}>View the published chapter <span aria-hidden="true">↗</span></a></p>
        <div class="topic-links"><span class="eyebrow">Explore this edition by topic</span>{c.topics.map(topic => <a href={`${catalogueUrl(c.edition)}?q=${encodeURIComponent(topic)}`}>{topic}</a>)}</div>
        {paths.length > 0 && <section><h2>Carry a question into the reading</h2><p>Read this contribution alongside related chapters, then work through an original companion discussion or exercise.</p>{paths.map(p => <a class="reading-link" href={`/reading-room/${p.slug}/`}><span class="eyebrow">Companion reading note</span><strong>{p.title}</strong><span aria-hidden="true">→</span></a>)}</section>}
        <section class="chapter-citation"><h2>Cite this contribution</h2><p id="chapter-citation">{chapterCitation(c)}</p><div class="citation-actions"><button class="button" type="button" data-copy="chapter-citation" data-enhanced hidden>Copy citation</button><span role="status" class="small" aria-live="polite"></span></div><p class="citation-downloads"><a href={`/citations/${c.id}.bib`} download>BibTeX</a><a href={`/citations/${c.id}.ris`} download>RIS</a></p><p class="small">Reference details: <a href={c.source}>published chapter metadata</a>. <a href={`/contact/?chapter=${c.id}`}>Report a correction.</a></p></section>
        {related.length > 0 && <section><h2>Nearby in the subject index</h2><p class="small">Other chapters in this edition sharing a companion topic.</p><ChapterList chapters={related} compact /></section>}
      </article>
      <aside class="book-aside" aria-label="Edition information"><img src={edition.cover} alt={`${edition.label} cover`} width="180" height="270" loading="lazy" /><p class="eyebrow">The handbook</p><h2>{edition.label}</h2><dl><dt>Year</dt><dd>{edition.year}</dd><dt>Chapter pages</dt><dd>{c.pages.replace('-', '–')}</dd><dt>Publisher</dt><dd>{publisher}</dd><dt>Print ISBN</dt><dd>{edition.isbn}</dd></dl><a class="button" href={c.edition === '2e' ? '/book/' : '/book/first-edition/'}>Edition details <span aria-hidden="true">→</span></a></aside>
    </div>
    <nav class="chapter-pagination" aria-label="Previous and next chapters"><div>{previous && <a href={previous.url}><span class="eyebrow">← Previous chapter</span>{previous.title}</a>}</div><div>{next && <a href={next.url}><span class="eyebrow">Next chapter →</span>{next.title}</a>}</div></nav>
  </div>
</Layout>
