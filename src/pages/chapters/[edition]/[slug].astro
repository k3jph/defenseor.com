---
import Layout from '../../../layouts/Layout.astro';
import ChapterList from '../../../components/ChapterList.astro';
import { chapters, editions, personSlug, title, publisher, chapterPathways } from '../../../data/catalogue.mjs';
export function getStaticPaths() { return chapters.map(chapter => ({ params: { edition: chapter.edition, slug: chapter.slug }, props: { chapter } })); }
const { chapter: c } = Astro.props;
const edition = editions[c.edition];
const paths = chapterPathways(c);
const siblings = chapters.filter(item => item.edition === c.edition);
const related = siblings.filter(item => item.id !== c.id && item.topics.some(topic => c.topics.includes(topic))).slice(0, 3);
const previous = siblings.find(item => item.number === c.number - 1);
const next = siblings.find(item => item.number === c.number + 1);
const schema = { '@context': 'https://schema.org', '@type': 'Chapter', name: c.title, position: c.number, author: c.authors.map(name => ({ '@type': 'Person', name })), isPartOf: { '@type': 'Book', name: title, bookEdition: c.edition === '2e' ? '2' : '1', isbn: edition.isbn, copyrightYear: edition.year } };
---
<Layout title={c.title} active="Chapters" schema={schema} description={`${c.title}, by ${c.authors.join(', ')}. Chapter ${c.number} of the ${edition.label.toLowerCase()} of the handbook.`}>
  <div class="wrap"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={c.edition === '2e' ? '/chapters/' : '/book/first-edition/'}>{edition.label}</a><span aria-hidden="true">/</span><span>Chapter {c.number}</span></nav>
  {c.edition === '1e' && <aside class="archive-notice">First-edition archive · 2020. This record describes the earlier edition, not the current contents. <a href="/chapters/">Explore the second edition.</a></aside>}
  <header class="chapter-header"><div class="chapter-ordinal" aria-hidden="true">{String(c.number).padStart(2, '0')}</div><div><p class="eyebrow">{edition.label} · Part {['I', 'II', 'III', 'IV'][c.part]} · {edition.parts[c.part]}</p><h1>{c.title}</h1><p class="chapter-authors">{c.authors.map((name, i) => <>{i > 0 && <span class="author-separator">; </span>}<a href={`/contributors/${personSlug(name)}/`}>{name}</a></>)}</p></div></header>
  <div class="article-grid"><article class="prose"><h2>A contribution to the handbook</h2><p>This is chapter {c.number} of the {edition.label.toLowerCase()} of <cite>{title}</cite>, in the part titled “{edition.parts[c.part]}.” The chapter is credited to the authors named above. This companion page provides its place in the collection and routes to the authors’ other contributions; the chapter text is available through the book.</p><div class="topic-links"><span class="eyebrow">Indexed topics</span>{c.topics.map(topic => <a href={`/chapters/?q=${encodeURIComponent(topic)}`}>{topic}</a>)}</div>
  {paths.length > 0 && <section><h2>Carry a question into the reading</h2><p>The companion reading notes below place this chapter alongside other contributions. Their questions and exercises are original website material, not a summary of this chapter or an account of the authors’ conclusions.</p>{paths.map(p => <a class="reading-link" href={`/reading-room/${p.slug}/`}><span class="eyebrow">Companion reading note</span><strong>{p.title}</strong><span aria-hidden="true">→</span></a>)}</section>}
  {related.length > 0 && <section><h2>Nearby in the subject index</h2><p class="small">Other chapters in this edition sharing a companion-site topic.</p><ChapterList chapters={related} compact /></section>}
  <section class="source-note"><h2>Source and attribution</h2><p>The chapter title, author order, numbering, and part placement come from the <a href={edition.source}>{c.edition === '2e' ? 'publisher’s contents' : 'first-edition contents on Natalie Scala’s website'}</a>. This is a bibliographic companion record, not the chapter’s abstract. Chapter-specific page ranges and identifiers have not been added without verification.</p></section>
  </article><aside class="book-aside" aria-label="Edition information"><img src={edition.cover} alt={`${edition.label} cover`} width="180" height="270" loading="lazy" /><p class="eyebrow">The handbook</p><h2>{edition.label}</h2><dl><dt>Year</dt><dd>{edition.year}</dd><dt>Publisher</dt><dd>{publisher}</dd><dt>Print ISBN</dt><dd>{edition.isbn}</dd></dl><a class="button" href={c.edition === '2e' ? '/book/' : '/book/first-edition/'}>Edition details <span aria-hidden="true">→</span></a></aside></div>
  <nav class="chapter-pagination" aria-label="Previous and next chapters"><div>{previous && <a href={previous.url}><span class="eyebrow">← Previous chapter</span>{previous.title}</a>}</div><div>{next && <a href={next.url}><span class="eyebrow">Next chapter →</span>{next.title}</a>}</div></nav></div>
</Layout>
