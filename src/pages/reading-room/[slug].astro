---
import Layout from '../../layouts/Layout.astro';
import ChapterList from '../../components/ChapterList.astro';
import { pathways, currentChapters } from '../../data/catalogue.mjs';
export function getStaticPaths() { return pathways.map(pathway => ({ params: { slug: pathway.slug }, props: { pathway } })); }
const { pathway: p } = Astro.props;
const selected = p.numbers.map(number => currentChapters.find(c => c.number === number));
---
<Layout title={p.title} active="Reading room">
  <div class="wrap page-intro"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/reading-room/">Reading room</a><span aria-hidden="true">/</span><span>Reading note</span></nav><p class="eyebrow">{p.label}</p><h1>{p.title}</h1><p class="editorial-label">Original companion reading note · Second-edition chapter topics</p><button class="button print-button" type="button" data-print>Print this reading note</button></div>
  <div class="wrap article-grid"><article class="prose"><h2>The question</h2><p>{p.intro}</p><h2>A suggested reading sequence</h2><ChapterList chapters={selected} compact /><p class="source-note">This sequence is an editorial suggestion based on the published chapter topics. Read the chapters to establish their methods, scope, and conclusions; the questions below do not assert what the authors conclude.</p><h2>Questions to carry into the reading</h2><ol class="discussion-questions">{p.questions.map(q => <li>{q}</li>)}</ol><section class="exercise"><p class="eyebrow">Try it in discussion</p><h2>A small exercise</h2><p>{p.exercise}</p></section><h2>After the reading</h2><p>Return to your original question. Identify which part of your answer now rests on a particular chapter, which part depends on your own assumptions, and which part remains unresolved. Give the chapter authors credit for the specific contribution you used. An answer can become more useful by stating a limit clearly; there is no need to make every chapter settle every part of the problem.</p></article><aside class="reading-aside"><p class="eyebrow">At a glance</p><dl><dt>Edition</dt><dd>Second · 2024</dd><dt>Readings</dt><dd>{p.numbers.length} chapters</dd><dt>Format</dt><dd>Reading and discussion</dd><dt>Materials</dt><dd>The handbook and your notes</dd></dl><p class="small">The exercise is companion-site material. It is not reproduced from the book or attributed to the chapter authors.</p><a class="text-link" href="/book/">Find the handbook <span aria-hidden="true">→</span></a></aside></div>
</Layout>
